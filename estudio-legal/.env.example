# Copia este archivo a .env.local para desarrollo, o define estas variables en Vercel (Settings -> Environment Variables).
# Ninguna es obligatoria: el sitio funciona sin ellas. NO subas valores reales al repositorio.

# Dirección pública del sitio, si cambia el dominio (por defecto: https://www.defensaspavez.com).
# NEXT_PUBLIC_SITE_URL=https://www.defensaspavez.com

# Reseñas reales de Google (ver README, sección "Conectar las reseñas reales de Google").
# NEXT_PUBLIC_GOOGLE_PLACE_ID=
# GOOGLE_PLACE_ID=
# GOOGLE_PLACES_API_KEY=
